# Multi-AI Bridge
HOST=127.0.0.1
PORT=8100
HEADLESS=true
BROWSER_SLOW_MO=0
STEALTH_ENABLED=true
MAX_INSTANCES_PER_PLATFORM=3
REQUEST_TIMEOUT=180
SESSION_KEEPALIVE_INTERVAL=600

# Protect the HTTP service when it is reachable beyond localhost.
API_KEY=

# Runtime state lives outside the source directory by default.
# Windows: %LOCALAPPDATA%\AuroraBridge
# Linux: ~/.local/share/aurora-bridge
AURORA_BRIDGE_DATA_DIR=
ACCOUNTS_DB_PATH=
CREDENTIAL_KEY_PATH=

# browser_first | browser_only | api_first | api_only
PLATFORM_MODES=

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

TONGYI_API_KEY=
TONGYI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
TONGYI_MODEL=qwen-max

KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

DOUBAO_API_KEY=
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

CHATGPT_API_KEY=
CHATGPT_API_BASE=https://api.openai.com/v1
CHATGPT_MODEL=gpt-4o

CLAUDE_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
